---
<footer class="footer">
  <div class="container">
    <div class="footer-content">
      <div class="footer-brand">
        <a href="#hero" class="footer-logo">
          <span class="logo-bracket">&lt;</span>
          <span class="logo-text">VM</span>
          <span class="logo-bracket">/&gt;</span>
        </a>
        <p class="footer-tagline">
          Building scalable software, intelligent systems, and high-performance web applications.
        </p>
      </div>

      <div class="footer-links">
        <div class="footer-col">
          <h4>Navigation</h4>
          <a href="#about">About</a>
          <a href="#skills">Skills</a>
          <a href="#projects">Projects</a>
          <a href="#experience">Experience</a>
          <a href="#contact">Contact</a>
        </div>
        <div class="footer-col">
          <h4>Connect</h4>
          <a href="https://github.com/ph03n1xc0d3s" target="_blank" rel="noopener noreferrer">GitHub</a>
          <!-- Add more social links when available -->
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {new Date().getFullYear()} Vaibhav Maini. Built with passion and lots of ☕</p>
      <p class="footer-tech">Built with <span class="gradient-text">Astro</span></p>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding: var(--space-4xl) 0 var(--space-2xl);
    border-top: 1px solid var(--border-subtle);
    background: var(--bg-secondary);
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4xl);
    margin-bottom: var(--space-3xl);
  }

  .footer-brand {
    max-width: 320px;
  }

  .footer-logo {
    font-size: 1.4rem;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 2px;
    margin-bottom: var(--space-md);
  }

  .logo-bracket {
    color: var(--accent-primary);
    font-family: var(--font-mono);
  }

  .logo-text {
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .footer-tagline {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.7;
  }

  .footer-links {
    display: flex;
    gap: var(--space-4xl);
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .footer-col h4 {
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: var(--space-sm);
    color: var(--text-primary);
  }

  .footer-col a {
    font-size: 0.9rem;
    color: var(--text-muted);
    transition: color var(--transition-fast);
    padding: 2px 0;
  }

  .footer-col a:hover {
    color: var(--accent-primary);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-2xl);
    border-top: 1px solid var(--border-subtle);
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .footer-tech {
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  @media (max-width: 768px) {
    .footer-content {
      flex-direction: column;
      gap: var(--space-2xl);
    }

    .footer-bottom {
      flex-direction: column;
      gap: var(--space-sm);
      text-align: center;
    }
  }
</style>
